{:paths ["src"]
 :deps  {org.clojure/clojure {:mvn/version "1.11.1"}}
 :tasks
 {:requires [[clojure.string :as str]]

  test      {:doc  "Run the test suite."
             :task (clojure "-M:test" "-m" "cognitect.test-runner")}

  test:bb   {:doc         "Run the test suite using Babashka."
             :extra-paths ["test"]
             :extra-deps  {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" 
                                                                 :git/sha "dfb30dd"}}
             :task        (exec 'cognitect.test-runner.api/test)}

  test:jolt {:doc  "Run tests in jolt"
             :task (shell "../../community/jolt/jolt/bin/jolt" "-M:jolt-test")} 

  test:all  {:doc     "Run the test suite with both Clojure and Babashka."
             :depends [test test:bb]}

  ci        {:doc     "Run the CI pipeline of tests and build the JAR."
             :depends [test:all] ; or just test
             :task    (clojure "-T:build" "jar")}

  ci:deploy {:doc     "Run the CI pipeline and deploy the JAR."
             :depends [ci]
             :task    (clojure "-T:build" "deploy")}

  install   {:doc  "Install the JAR locally (build via ci)."
             :task (clojure "-T:build" "install")}
  
  git-deps-docs
  {:doc      "Regenerate docs/git-deps.md from the latest tag"
   :requires ([babashka.process :as p]
              [clojure.string :as str])
   :task
   (let [tag  (-> (p/shell {:out :string} "git describe --tags --abbrev=0")
                  :out str/trim)
         sha  (-> (p/shell {:out :string} "git rev-list -n 1" tag)
                  :out str/trim)
         tmpl (slurp "docs/git-deps.template.md")]
     (spit "docs/git-deps.md"
           (-> tmpl
               (str/replace "{{TAG}}" (str "\"" tag "\""))
               (str/replace "{{SHA}}" (str "\"" sha "\""))))
     (println "Wrote docs for" tag sha))}}}
